{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(aws:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(~/.config/*.env)",
      "Edit(./**/.env)"
    ],
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "mcp__anti-scope-creep__service_status",
      "mcp__anti-scope-creep__list_contracts",
      "mcp__anti-scope-creep__get_findings"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/agent-hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false
}
