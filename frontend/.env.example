# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Set to "true" to use the in-memory mock API instead of the backend (no backend needed).
VITE_USE_MOCK=false

# Set to "true" to send product analytics events to the backend (POST /events).
# Off by default, so local runs and tests send nothing. See docs/analytics.md.
VITE_ANALYTICS=false
