# Base URL of the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Set to "true" to use the in-memory mock API instead of the backend (no backend needed).
VITE_USE_MOCK=false

# PostHog project API key (phc_...); empty = no analytics. See docs/analytics.md.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
