# Database connection (SQLAlchemy URL). Local Postgres from `make db`:
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/asc

# Database for Alembic migrations. Optional: falls back to DATABASE_URL.
# On Neon, DATABASE_URL is the pooled endpoint (`-pooler` host) and this is the direct one.
# MIGRATIONS_DATABASE_URL=postgresql+psycopg://user:password@ep-example.eu-central-1.aws.neon.tech/asc?sslmode=require

# HS256 signing key for access tokens. Use a long random value (at least 32 bytes),
# e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
# If unset, a random key is generated at startup and tokens do not survive a restart.
JWT_SECRET=change-me-to-a-long-random-value

# Analyzer implementation. Only `stub` exists in the MVP.
ANALYZER=stub

# An `analyzing` contract older than this many seconds is marked `failed` on its next read or change.
ANALYSIS_STALE_AFTER_SECONDS=600

# Comma-separated exact origins allowed by CORS (no wildcards).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Seed demo users and contracts at startup if the demo user does not exist yet (local development only).
SEED_DEMO_DATA=true
