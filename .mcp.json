{
  "mcpServers": {
    "anti-scope-creep": {
      "command": "uv",
      "args": ["run", "--directory", "mcp-server", "python", "server.py"],
      "env": {
        "ASC_API_URL": "${ASC_API_URL:-http://localhost:8000}",
        "ASC_EMAIL": "${ASC_EMAIL:-}",
        "ASC_PASSWORD": "${ASC_PASSWORD:-}"
      }
    }
  }
}
