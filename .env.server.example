# One environment of compose.server.yaml (docs/self-host.md). Copy it per environment, outside the repository,
# for example prod.env and dev.env, readable only by the user that runs the stack (chmod 600).
# Placeholder values only: never commit a filled-in copy.

# Compose project, Tailscale node name and the public host: https://<COMPOSE_PROJECT_NAME>.<tailnet>.ts.net
COMPOSE_PROJECT_NAME=asc-prod
# Backend image tag in ghcr: prod or dev (the deploy workflows move these tags).
IMAGE_TAG=prod
# Local port on 127.0.0.1 for checks on the server; a different one per environment (prod 8000, dev 8001).
PORT=8000

# Neon pooled endpoint of this environment's branch.
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/asc?sslmode=require
# At least 32 random bytes, different per environment.
JWT_SECRET=replace-with-a-long-random-value
# The frontend origin of this environment (comma-separated if several).
CORS_ORIGINS=https://frontend.example.workers.dev

# stub or groq; groq needs GROQ_API_KEY. An empty GROQ_MODEL keeps the default model.
ANALYZER=stub
GROQ_API_KEY=
GROQ_MODEL=

# Telemetry export, both or neither (docs/architecture.md, section 6).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Tailscale auth key: tagged tag:asc, pre-approved, not ephemeral. Used for the first login only.
TS_AUTHKEY=tskey-auth-placeholder
